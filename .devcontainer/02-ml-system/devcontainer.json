{
  "name": "Cloud-Based ML — Lab 1 (02-ml-system)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/aws-cli:1": {
      "version": "latest"
    }
  },
  // Codespaces only lists configurations found under the repository root, so this
  // entry exists to make the lab selectable in the "New codespace" dialog. It opens
  // the container directly in the lab folder, which is what keeps `make` working
  // without an extra `cd` that students forget.
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/02-ml-system",
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "remoteEnv": {
    "AWS_DEFAULT_REGION": "us-east-1",
    "AWS_REGION": "us-east-1",
    "PYTHONPATH": "${containerWorkspaceFolder}/src",
    "PATH": "${containerWorkspaceFolder}/.venv/bin:/usr/local/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "files.eol": "\n"
      }
    }
  }
}
